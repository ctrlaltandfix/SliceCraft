---
import Logo from './Logo.astro';

const cols = [
  { title: 'Product', links: [
    { label: 'Features', href: '#features' },
    { label: 'Conditions', href: '#conditions' },
    { label: 'Pricing', href: '#pricing' },
    { label: 'What\'s new', href: '#' },
  ]},
  { title: 'Resources', links: [
    { label: 'CRPS guide', href: '#' },
    { label: 'Asthma action plan', href: '#' },
    { label: 'Help centre', href: '#' },
    { label: 'Contact support', href: '#' },
  ]},
  { title: 'Company', links: [
    { label: 'About', href: '#' },
    { label: 'Privacy', href: '#privacy' },
    { label: 'Terms', href: '#' },
    { label: 'Accessibility', href: '#' },
  ]},
];

const year = new Date().getFullYear();
---
<footer class="border-t hairline">
  <div class="container-page py-16">
    <div class="grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5">
        <Logo />
        <p class="mt-5 max-w-sm text-sm text-ink-muted leading-relaxed">
          A calm home for your health. Built with the chronic illness community,
          for the chronic illness community.
        </p>
      </div>

      <div class="lg:col-span-7 grid sm:grid-cols-3 gap-8">
        {cols.map(col => (
          <div>
            <h4 class="text-xs font-semibold tracking-widest uppercase text-ink-muted">{col.title}</h4>
            <ul class="mt-4 space-y-2.5">
              {col.links.map(l => (
                <li>
                  <a href={l.href} class="text-sm text-ink-soft hover:text-ink transition-colors">{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-14 pt-6 border-t hairline flex flex-wrap items-center justify-between gap-3 text-xs text-ink-muted">
      <p>© {year} WellNest. All rights reserved.</p>
      <p class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-nest-500 animate-pulse-soft"></span>
        Made with care, in calm.
      </p>
    </div>
  </div>
</footer>
