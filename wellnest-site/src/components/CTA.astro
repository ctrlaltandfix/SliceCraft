---
import Icon from './Icon.astro';
---
<section id="start" class="container-page py-24 md:py-36">
  <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-nest-50 via-canvas to-emerald-50 border hairline p-10 md:p-16 text-center">
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[40rem] h-[40rem] bg-nest-200/40 rounded-full blur-3xl"></div>
    <div class="relative">
      <span class="eyebrow justify-center"><span class="dot"></span>Ready when you are</span>
      <h2 class="mt-5 text-4xl md:text-6xl font-semibold leading-[1.05] max-w-3xl mx-auto">
        Take the weight of managing your health off your shoulders.
      </h2>
      <p class="mt-5 text-ink-muted max-w-xl mx-auto">
        Free forever for the essentials. Premium when you're ready for more.
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href="#signup" class="btn-primary">
          Create your nest
          <Icon name="arrow" class="w-4 h-4" />
        </a>
        <a href="#pricing" class="btn-ghost">
          See pricing
        </a>
      </div>
    </div>
  </div>
</section>
