---
import Icon from './Icon.astro';
---
<section class="relative overflow-hidden">
  <!-- ambient gradient mesh -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-40 -left-32 w-[34rem] h-[34rem] rounded-full bg-nest-200/60 blur-3xl animate-float-slow"></div>
    <div class="absolute -top-20 right-0 w-[28rem] h-[28rem] rounded-full bg-emerald-100/70 blur-3xl"></div>
    <div class="absolute top-72 left-1/3 w-[20rem] h-[20rem] rounded-full bg-teal-100/60 blur-3xl"></div>
    <svg class="absolute inset-0 w-full h-full opacity-[0.04]" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="g" width="32" height="32" patternUnits="userSpaceOnUse">
          <path d="M0 .5H32" fill="none" stroke="currentColor" stroke-width="0.5"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#g)"/>
    </svg>
  </div>

  <div class="container-page pt-16 pb-24 md:pt-24 md:pb-36">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-7">
        <span class="eyebrow">
          <span class="dot animate-pulse-soft"></span>
          Your chronic illness companion
        </span>

        <h1 class="mt-6 text-[2.75rem] sm:text-6xl lg:text-7xl font-semibold leading-[1.02] text-ink">
          All of your health,
          <span class="block">
            in one
            <span class="relative inline-block">
              <span class="relative z-10 italic font-light text-nest-700">calm nest.</span>
              <span class="absolute inset-x-0 bottom-1 h-3 bg-nest-200/70 -z-0 rounded"></span>
            </span>
          </span>
        </h1>

        <p class="mt-6 max-w-xl text-lg text-ink-muted leading-relaxed">
          WellNest brings your medications, appointments, symptoms, expenses
          and emergency plan into one private, beautifully simple place — so
          you can spend less time managing and more time living.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="#start" class="btn-primary">
            Start free — no card needed
            <Icon name="arrow" class="w-4 h-4" />
          </a>
          <a href="#features" class="btn-ghost">
            See what's inside
          </a>
        </div>

        <div class="mt-10 flex items-center gap-6 text-xs text-ink-muted">
          <div class="flex items-center gap-2">
            <Icon name="shield" class="w-4 h-4 text-nest-600" />
            <span>End-to-end private</span>
          </div>
          <div class="hidden sm:flex items-center gap-2">
            <Icon name="lock" class="w-4 h-4 text-nest-600" />
            <span>Auto session timeout</span>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="sparkle" class="w-4 h-4 text-nest-600" />
            <span>Built with the CRPS community</span>
          </div>
        </div>
      </div>

      <!-- product mock -->
      <div class="lg:col-span-5">
        <div class="relative">
          <div class="absolute -inset-6 bg-gradient-to-br from-nest-300/40 via-emerald-200/30 to-teal-200/30 blur-2xl rounded-[2.5rem]"></div>

          <div class="relative surface shadow-[0_30px_80px_-20px_rgba(6,78,59,0.25)] overflow-hidden">
            <!-- chrome -->
            <div class="flex items-center gap-1.5 px-4 py-3 border-b hairline">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-300/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-300/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-nest-400/90"></span>
              <span class="ml-3 text-[11px] text-ink-muted">wellnest.services / dashboard</span>
            </div>

            <div class="p-5 space-y-4">
              <div class="flex items-center justify-between">
                <div>
                  <p class="text-[11px] uppercase tracking-widest text-ink-muted">Today</p>
                  <h3 class="text-xl font-semibold mt-0.5">Good morning, Alex</h3>
                </div>
                <span class="inline-flex items-center gap-1.5 text-[11px] font-medium px-2.5 py-1 rounded-full bg-nest-50 text-nest-700 border border-nest-100">
                  <span class="w-1.5 h-1.5 rounded-full bg-nest-500 animate-pulse-soft"></span>
                  All synced
                </span>
              </div>

              <!-- stat row -->
              <div class="grid grid-cols-3 gap-3">
                <div class="rounded-2xl bg-canvas-warm p-3">
                  <p class="text-[10px] uppercase tracking-wider text-ink-muted">Pain</p>
                  <p class="mt-1 text-2xl font-semibold text-ink">3<span class="text-sm text-ink-muted">/10</span></p>
                  <p class="text-[10px] text-nest-700 mt-0.5">↓ better than yesterday</p>
                </div>
                <div class="rounded-2xl bg-canvas-warm p-3">
                  <p class="text-[10px] uppercase tracking-wider text-ink-muted">Meds</p>
                  <p class="mt-1 text-2xl font-semibold text-ink">4<span class="text-sm text-ink-muted">/5</span></p>
                  <p class="text-[10px] text-ink-muted mt-0.5">1 due at 18:00</p>
                </div>
                <div class="rounded-2xl bg-canvas-warm p-3">
                  <p class="text-[10px] uppercase tracking-wider text-ink-muted">Energy</p>
                  <p class="mt-1 text-2xl font-semibold text-ink">62<span class="text-sm text-ink-muted">%</span></p>
                  <p class="text-[10px] text-ink-muted mt-0.5">Pacing on track</p>
                </div>
              </div>

              <!-- mini chart -->
              <div class="rounded-2xl border hairline p-4 bg-white">
                <div class="flex items-center justify-between mb-3">
                  <p class="text-xs font-medium text-ink">Pain — last 7 days</p>
                  <span class="text-[10px] text-ink-muted">Avg 4.1</span>
                </div>
                <svg viewBox="0 0 200 60" class="w-full h-14">
                  <defs>
                    <linearGradient id="ln" x1="0" x2="0" y1="0" y2="1">
                      <stop offset="0%" stop-color="#059669" stop-opacity="0.35"/>
                      <stop offset="100%" stop-color="#059669" stop-opacity="0"/>
                    </linearGradient>
                  </defs>
                  <path d="M0 40 L30 30 L60 36 L90 22 L120 28 L150 18 L180 24 L200 14 L200 60 L0 60 Z" fill="url(#ln)"/>
                  <path d="M0 40 L30 30 L60 36 L90 22 L120 28 L150 18 L180 24 L200 14" fill="none" stroke="#059669" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>

              <!-- nav rail -->
              <div class="flex items-center gap-2 overflow-hidden">
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[11px] font-medium bg-ink text-white">
                  <Icon name="dashboard" class="w-3.5 h-3.5" /> Dashboard
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[11px] bg-canvas-warm text-ink-soft">
                  <Icon name="flame" class="w-3.5 h-3.5" /> CRPSmate
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[11px] bg-canvas-warm text-ink-soft">
                  <Icon name="pill" class="w-3.5 h-3.5" /> Meds
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[11px] bg-canvas-warm text-ink-soft">
                  <Icon name="calendar" class="w-3.5 h-3.5" /> Visits
                </span>
              </div>
            </div>
          </div>

          <!-- floating emergency card -->
          <div class="absolute -bottom-6 -left-6 hidden sm:flex items-center gap-3 rounded-2xl bg-white border hairline px-4 py-3 shadow-xl">
            <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-gradient-to-br from-rose-400 to-rose-600 text-white">
              <Icon name="alert" class="w-4 h-4" />
            </span>
            <div>
              <p class="text-xs font-semibold text-ink">Emergency Plan</p>
              <p class="text-[11px] text-ink-muted">Share in one tap</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
