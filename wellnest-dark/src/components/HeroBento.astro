---
import Icon from './Icon.astro';
---
<section class="relative pt-12 md:pt-20 pb-20 md:pb-32 grain">
  <!-- aurora field -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute top-[-10rem] left-[-10rem] w-[42rem] h-[42rem] rounded-full blur-[120px] opacity-50 animate-float-orb" style="background: radial-gradient(circle, #00c853 0%, transparent 60%);"></div>
    <div class="absolute top-32 right-[-12rem] w-[40rem] h-[40rem] rounded-full blur-[120px] opacity-40 animate-float-orb" style="animation-delay:-4s; background: radial-gradient(circle, #6ee7b7 0%, transparent 65%);"></div>
    <div class="absolute top-1/2 left-1/3 w-[28rem] h-[28rem] rounded-full blur-[100px] opacity-25" style="background: radial-gradient(circle, #38bdf8 0%, transparent 60%);"></div>

    <!-- grid lines -->
    <svg class="absolute inset-0 w-full h-full opacity-[0.06]" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="g" width="56" height="56" patternUnits="userSpaceOnUse">
          <path d="M0 .5H56M.5 0V56" fill="none" stroke="white" stroke-width="0.5"/>
        </pattern>
        <radialGradient id="fade" cx="50%" cy="40%" r="60%">
          <stop offset="0%" stop-color="white" stop-opacity="1"/>
          <stop offset="100%" stop-color="white" stop-opacity="0"/>
        </radialGradient>
      </defs>
      <rect width="100%" height="100%" fill="url(#g)" mask="url(#m)" />
    </svg>
  </div>

  <div class="container-page">
    <!-- top label -->
    <div class="flex items-center justify-between flex-wrap gap-3 mb-10">
      <span class="pill"><span class="dot"></span>v2.0 — your chronic illness companion</span>
      <span class="hidden sm:inline-flex items-center gap-2 text-xs text-text-muted">
        <span class="w-1.5 h-1.5 rounded-full bg-nest-400 animate-pulse-ring"></span>
        Live · 47 people started a nest in the last hour
      </span>
    </div>

    <!-- big headline -->
    <h1 data-reveal class="font-semibold text-[2.5rem] sm:text-7xl lg:text-[6.5rem] leading-[0.95] tracking-tight">
      <span class="block">Your health,</span>
      <span class="block">
        <span class="text-aurora">finally</span>
        <span class="italic font-light">in flow.</span>
      </span>
    </h1>

    <p data-reveal class="mt-8 max-w-2xl text-lg text-text-soft leading-relaxed">
      Eleven specialist modules. One private, kinetic dashboard.
      WellNest keeps your medications, flares, appointments and emergency
      plan moving in sync — so the work of being unwell doesn't run your day.
    </p>

    <div data-reveal class="mt-10 flex flex-wrap items-center gap-3">
      <a href="#start" class="btn-glow">
        Start free — no card
        <Icon name="arrow" class="w-4 h-4" />
      </a>
      <a href="#modules" class="btn-line">
        <Icon name="zap" class="w-4 h-4 text-nest-400" />
        See it move
      </a>
    </div>

    <!-- bento hero — 3 tiles below -->
    <div data-reveal class="mt-16 md:mt-20 grid grid-cols-12 gap-3 md:gap-4">
      <!-- Tile A: live dashboard mock -->
      <article class="col-span-12 lg:col-span-7 row-span-2 glass relative overflow-hidden p-6 md:p-8 min-h-[22rem]">
        <div class="absolute -top-32 -right-20 w-[28rem] h-[28rem] rounded-full blur-3xl opacity-30" style="background: radial-gradient(circle, #34d399 0%, transparent 60%);"></div>

        <div class="relative flex items-center justify-between">
          <div>
            <p class="text-[10px] tracking-[0.18em] uppercase text-text-muted">Today / dashboard</p>
            <h3 class="mt-1 text-xl md:text-2xl font-semibold">Good morning, Alex</h3>
          </div>
          <span class="inline-flex items-center gap-1.5 text-[11px] font-medium px-2.5 py-1 rounded-full bg-nest-500/10 text-nest-300 border border-nest-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-nest-400 animate-pulse-ring"></span>
            All synced
          </span>
        </div>

        <div class="relative mt-6 grid grid-cols-3 gap-3">
          <div class="rounded-2xl border border-line bg-white/[0.03] p-3">
            <p class="text-[10px] uppercase tracking-wider text-text-muted">Pain</p>
            <p class="mt-1 text-2xl font-semibold"><span data-counter data-from="6" data-to="3">3</span><span class="text-sm text-text-muted">/10</span></p>
            <p class="text-[10px] text-nest-400 mt-0.5">↓ better</p>
          </div>
          <div class="rounded-2xl border border-line bg-white/[0.03] p-3">
            <p class="text-[10px] uppercase tracking-wider text-text-muted">Meds</p>
            <p class="mt-1 text-2xl font-semibold"><span data-counter data-from="0" data-to="4">4</span><span class="text-sm text-text-muted">/5</span></p>
            <p class="text-[10px] text-text-muted mt-0.5">1 due 18:00</p>
          </div>
          <div class="rounded-2xl border border-line bg-white/[0.03] p-3">
            <p class="text-[10px] uppercase tracking-wider text-text-muted">Energy</p>
            <p class="mt-1 text-2xl font-semibold"><span data-counter data-from="20" data-to="62">62</span><span class="text-sm text-text-muted">%</span></p>
            <p class="text-[10px] text-text-muted mt-0.5">Pacing on</p>
          </div>
        </div>

        <div class="relative mt-5 rounded-2xl border border-line bg-white/[0.03] p-4">
          <div class="flex items-center justify-between">
            <p class="text-xs font-medium">Pain · 7 day flow</p>
            <span class="text-[10px] text-text-muted">Avg 4.1</span>
          </div>
          <svg viewBox="0 0 400 80" class="w-full h-20 mt-2" preserveAspectRatio="none">
            <defs>
              <linearGradient id="gradLine" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0%" stop-color="#34d399" stop-opacity="0.5"/>
                <stop offset="100%" stop-color="#34d399" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <path d="M0 50 L60 38 L120 46 L180 28 L240 36 L300 22 L360 30 L400 16 L400 80 L0 80 Z" fill="url(#gradLine)"/>
            <path class="draw-line" d="M0 50 L60 38 L120 46 L180 28 L240 36 L300 22 L360 30 L400 16" fill="none" stroke="#34d399" stroke-width="2" stroke-linecap="round"/>
            <circle cx="400" cy="16" r="3.5" fill="#34d399"/>
            <circle cx="400" cy="16" r="6" fill="#34d399" opacity="0.3" class="animate-pulse-ring"/>
          </svg>
        </div>

        <div class="relative mt-4 flex items-center gap-2 overflow-hidden">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[11px] font-medium bg-white text-void">
            <Icon name="dashboard" class="w-3.5 h-3.5"/> Dashboard
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[11px] bg-white/[0.06] text-text-soft border border-line">
            <Icon name="flame" class="w-3.5 h-3.5 text-rose-400"/> CRPSmate
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[11px] bg-white/[0.06] text-text-soft border border-line">
            <Icon name="pill" class="w-3.5 h-3.5 text-nest-400"/> Meds
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[11px] bg-white/[0.06] text-text-soft border border-line">
            <Icon name="calendar" class="w-3.5 h-3.5 text-sky-400"/> Visits
          </span>
        </div>
      </article>

      <!-- Tile B: Emergency -->
      <article class="col-span-6 lg:col-span-5 glass ring-aurora overflow-hidden p-6 relative" style="--ang: 220deg;">
        <div class="absolute -bottom-16 -right-10 w-60 h-60 rounded-full blur-3xl opacity-50" style="background: radial-gradient(circle, #fb7185 0%, transparent 60%);"></div>
        <div class="relative flex items-center gap-2 text-rose-300 text-[11px] tracking-[0.18em] uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-rose-400 animate-pulse-ring" style="--tw-shadow:0 0 12px #fb7185;"></span>
          One-tap share
        </div>
        <h3 class="relative mt-4 text-2xl md:text-3xl font-semibold leading-tight">Emergency Plan, ready before you need it.</h3>
        <p class="relative mt-3 text-sm text-text-soft">Meds, allergies, contacts and pain plan as a tappable QR or printable PDF.</p>
        <div class="relative mt-6 flex items-center gap-2.5">
          <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-rose-500/15 border border-rose-400/30 text-rose-300">
            <Icon name="alert" class="w-4 h-4"/>
          </span>
          <span class="text-xs text-text-muted">Always available offline.</span>
        </div>
      </article>

      <!-- Tile C: Stat -->
      <article class="col-span-6 lg:col-span-3 glass p-6 relative overflow-hidden">
        <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full blur-2xl opacity-30" style="background: radial-gradient(circle, #34d399 0%, transparent 60%);"></div>
        <p class="text-[11px] tracking-[0.18em] uppercase text-text-muted">Logged this month</p>
        <p class="mt-3 text-5xl font-semibold tracking-tight" data-counter data-from="0" data-to="12480" data-suffix="" data-format="comma">12,480</p>
        <p class="text-xs text-text-muted mt-1">flares, doses & visits</p>
        <div class="mt-5 h-1 w-full rounded-full bg-white/5 overflow-hidden">
          <div class="h-full bg-gradient-to-r from-nest-400 to-emerald-700" style="width:74%"></div>
        </div>
      </article>

      <!-- Tile D: Mini AsthmaMate waveform -->
      <article class="col-span-12 lg:col-span-2 glass p-6 relative overflow-hidden">
        <p class="text-[11px] tracking-[0.18em] uppercase text-text-muted">AsthmaMate</p>
        <p class="mt-2 text-sm font-medium">Peak flow</p>
        <div class="mt-4 flex items-end gap-1 h-16">
          {[...Array(14)].map((_, i) => (
            <span class="bar block w-1.5 rounded-t bg-gradient-to-t from-sky-500 to-cyan-300" style={`height:${30 + (i*7)%55}%; animation-delay:${i*0.08}s`}></span>
          ))}
        </div>
        <p class="text-[10px] text-nest-400 mt-2">Green zone</p>
      </article>
    </div>
  </div>
</section>
