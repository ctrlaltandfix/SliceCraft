---
import Logo from './Logo.astro';

const cols = [
  { title: 'Product',   links: [['Modules','#modules'],['Conditions','#conditions'],['Pricing','#pricing'],['What\'s new','#']] },
  { title: 'Resources', links: [['CRPS guide','#'],['Asthma action plan','#'],['Help centre','#'],['Contact','#']] },
  { title: 'Company',   links: [['About','#'],['Privacy','#privacy'],['Terms','#'],['Accessibility','#']] },
];
const year = new Date().getFullYear();
---
<footer class="border-t border-line">
  <div class="container-page py-16">
    <div class="grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5">
        <Logo />
        <p class="mt-5 max-w-sm text-sm text-text-muted leading-relaxed">
          A calm home for your health. Built with the chronic illness community,
          for the chronic illness community.
        </p>
      </div>
      <div class="lg:col-span-7 grid sm:grid-cols-3 gap-8">
        {cols.map(col => (
          <div>
            <h4 class="text-xs font-semibold tracking-[0.18em] uppercase text-text-muted">{col.title}</h4>
            <ul class="mt-4 space-y-2.5">
              {col.links.map(([label, href]) => (
                <li><a href={href} class="text-sm text-text-soft hover:text-text transition-colors">{label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <div class="mt-14 pt-6 border-t border-line flex flex-wrap items-center justify-between gap-3 text-xs text-text-muted">
      <p>© {year} WellNest. All rights reserved.</p>
      <p class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-nest-400 animate-pulse-ring"></span>
        Made with care, in calm.
      </p>
    </div>
  </div>
</footer>
